APP_ENV=development
DATABASE_URL=sqlite:///./nss_bloodconnect.db
# Development generates an ephemeral JWT secret when JWT_SECRET is omitted.
# Production must set a unique, high-entropy secret through the hosting platform.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_NAME=nss_bloodconnect_session
CSRF_COOKIE_NAME=nss_bloodconnect_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=NSSBloodConnect/1.0
GEOCODING_TIMEOUT_SECONDS=5.0
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=replace-with-ai-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20.0
